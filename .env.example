# ==========================================
# Badminton Tournament Management Platform
# Root Environment Variables Template
# ==========================================

# Environment & Ports
NODE_ENV=development
PORT=4000
FRONTEND_PORT=3000

# Client & Server URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:4000/api/v1

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/badminton_db?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=badminton_db
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets (Generate secure random keys in production)
JWT_SECRET=super_secret_jwt_access_token_key_change_in_production_min32chars
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_key_change_in_production_min32chars
JWT_REFRESH_EXPIRATION=7d

# File Storage
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Cors
CORS_ORIGIN=http://localhost:3000,http://localhost:3001


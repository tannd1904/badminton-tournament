generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum TournamentStatus {
  DRAFT
  PENDING_APPROVAL
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  DRAW_COMPLETED
  SCHEDULE_PUBLISHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  SUSPENDED
}

enum TournamentVisibility {
  PUBLIC
  PRIVATE
  UNLISTED
}

enum StaffRole {
  ORGANIZER
  REFEREE
}

enum StaffStatus {
  INVITED
  ACCEPTED
  REVOKED
}

enum CourtStatus {
  AVAILABLE
  MAINTENANCE
  OCCUPIED
}

enum PlayType {
  SINGLE_MEN
  SINGLE_WOMEN
  DOUBLE_MEN
  DOUBLE_WOMEN
  DOUBLE_MIXED
}

enum EventFormat {
  KNOCKOUT
  ROUND_ROBIN
  ROUND_ROBIN_THEN_KNOCKOUT
}

enum EventStatus {
  DRAFT
  OPEN
  DRAWN
  IN_PROGRESS
  COMPLETED
}

enum ParticipantType {
  INDIVIDUAL
  PAIR
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  WAITLISTED
  WITHDRAWN
}

enum CheckInStatus {
  NOT_CHECKED_IN
  CHECKED_IN
}

enum InvitationStatus {
  ACCEPTED
  PENDING_CONFIRMATION
  DECLINED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum StageType {
  GROUP_STAGE
  KNOCKOUT_STAGE
}

enum StageStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum MatchStatus {
  SCHEDULED
  READY
  IN_PROGRESS
  COMPLETED
  CANCELLED
  WALKOVER
}

enum NextMatchSlot {
  TEAM_A
  TEAM_B
}

enum ScoreEventType {
  POINT_ADDED
  POINT_REMOVED
  SERVING_TEAM_CHANGED
  COURT_SIDES_SWAPPED
  SET_COMPLETED
  MATCH_COMPLETED
  SCORE_CORRECTED
}

model User {
  id            String      @id @default(uuid())
  email         String      @unique
  phone         String?     @unique
  fullName      String      @map("full_name")
  passwordHash  String      @map("password_hash")
  avatarUrl     String?     @map("avatar_url")
  role          UserRole    @default(USER)
  status        UserStatus  @default(ACTIVE)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  createdTournaments  Tournament[]        @relation("TournamentCreator")
  staffAssignments    TournamentStaff[]
  participantMembers  ParticipantMember[]
  officiatedMatches   Match[]             @relation("MatchReferee")
  announcements       Announcement[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  submittedRegistrations Registration[]   @relation("RegistrationSubmitter")
  reviewedRegistrations  Registration[]   @relation("RegistrationReviewer")
  scoreEvents         MatchScoreEvent[]

  @@map("users")
}

model Sport {
  id          String       @id @default(uuid())
  name        String
  code        String       @unique
  description String?
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  tournaments Tournament[]

  @@map("sports")
}

model Club {
  id            String        @id @default(uuid())
  name          String
  code          String?
  logoUrl       String?       @map("logo_url")
  description   String?
  contactPerson String?       @map("contact_person")
  contactPhone  String?       @map("contact_phone")
  createdAt     DateTime      @default(now()) @map("created_at")
  participants  Participant[]

  @@map("clubs")
}

model Venue {
  id           String       @id @default(uuid())
  name         String
  address      String
  city         String
  countryCode  String       @default("VN") @map("country_code")
  contactPhone String?      @map("contact_phone")
  description  String?
  createdAt    DateTime     @default(now()) @map("created_at")
  tournaments  Tournament[]
  courts       Court[]

  @@map("venues")
}

model Court {
  id           String      @id @default(uuid())
  venueId      String?     @map("venue_id")
  tournamentId String?     @map("tournament_id")
  name         String
  courtOrder   Int         @default(1) @map("court_order")
  status       CourtStatus @default(AVAILABLE)
  createdAt    DateTime    @default(now()) @map("created_at")

  venue      Venue?      @relation(fields: [venueId], references: [id], onDelete: SetNull)
  tournament Tournament? @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matches    Match[]

  @@map("courts")
}

model Tournament {
  id                          String               @id @default(uuid())
  name                        String
  slug                        String               @unique
  sportId                     String               @map("sport_id")
  venueId                     String?              @map("venue_id")
  countryCode                 String               @default("VN") @map("country_code")
  timezone                    String               @default("Asia/Ho_Chi_Minh")
  contactPhone                String?              @map("contact_phone")
  contactEmail                String?              @map("contact_email")
  bannerUrl                   String?              @map("banner_url")
  logoUrl                     String?              @map("logo_url")
  ruleContent                 String?              @map("rule_content")
  ruleAttachmentUrl           String?              @map("rule_attachment_url")
  registrationOpenAt          DateTime             @map("registration_open_at")
  registrationCloseAt         DateTime             @map("registration_close_at")
  tournamentStartAt           DateTime             @map("tournament_start_at")
  tournamentEndAt             DateTime             @map("tournament_end_at")
  maxEventsPerPlayer          Int                  @default(2) @map("max_events_per_player")
  matchIntervalMinutes        Int                  @default(15) @map("match_interval_minutes")
  defaultMatchDurationMinutes Int                  @default(35) @map("default_match_duration_minutes")
  totalCourts                 Int                  @default(4) @map("total_courts")
  status                      TournamentStatus     @default(DRAFT)
  visibility                  TournamentVisibility @default(PUBLIC)
  createdBy                   String               @map("created_by")
  createdAt                   DateTime             @default(now()) @map("created_at")
  updatedAt                   DateTime             @updatedAt @map("updated_at")

  sport         Sport             @relation(fields: [sportId], references: [id])
  venue         Venue?            @relation(fields: [venueId], references: [id], onDelete: SetNull)
  creator       User              @relation("TournamentCreator", fields: [createdBy], references: [id])
  staff         TournamentStaff[]
  events        Event[]
  courts        Court[]
  announcements Announcement[]
  sponsors      Sponsor[]
  auditLogs     AuditLog[]

  @@map("tournaments")
}

model TournamentStaff {
  id           String      @id @default(uuid())
  tournamentId String      @map("tournament_id")
  userId       String      @map("user_id")
  role         StaffRole
  status       StaffStatus @default(ACCEPTED)
  invitedAt    DateTime    @default(now()) @map("invited_at")
  acceptedAt   DateTime?   @map("accepted_at")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId, role])
  @@map("tournament_staff")
}

model Event {
  id                 String      @id @default(uuid())
  tournamentId       String      @map("tournament_id")
  name               String
  groupType          String      @default("OPEN") @map("group_type")
  playType           PlayType    @map("play_type")
  format             EventFormat @default(KNOCKOUT)
  entryFee           Decimal     @default(0.00) @map("entry_fee") @db.Decimal(12, 2)
  currency           String      @default("VND")
  maxParticipants    Int         @default(16) @map("max_participants")
  autoPairing        Boolean     @default(false) @map("auto_pairing")
  autoDraw           Boolean     @default(true) @map("auto_draw")
  hasThirdPlaceMatch Boolean     @default(true) @map("has_third_place_match")
  winPoints          Int         @default(2) @map("win_points")
  losePoints         Int         @default(0) @map("lose_points")
  defaultSetsToWin   Int         @default(2) @map("default_sets_to_win")
  isRegistrationOpen Boolean     @default(true) @map("is_registration_open")
  status             EventStatus @default(DRAFT)
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  tournament   Tournament    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  participants Participant[]
  stages       Stage[]
  matches      Match[]

  @@map("events")
}

model Participant {
  id                 String             @id @default(uuid())
  eventId            String             @map("event_id")
  clubId             String?            @map("club_id")
  displayName        String             @map("display_name")
  participantType    ParticipantType    @default(INDIVIDUAL) @map("participant_type")
  isSeeded           Boolean            @default(false) @map("is_seeded")
  seedNumber         Int?               @map("seed_number")
  registrationStatus RegistrationStatus @default(PENDING) @map("registration_status")
  checkInStatus      CheckInStatus      @default(NOT_CHECKED_IN) @map("check_in_status")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  event             Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  club              Club?               @relation(fields: [clubId], references: [id], onDelete: SetNull)
  members           ParticipantMember[]
  registration      Registration?
  payments          Payment[]
  groupParticipants GroupParticipant[]
  matchesAsTeamA    Match[]             @relation("TeamAMatches")
  matchesAsTeamB    Match[]             @relation("TeamBMatches")
  wonMatches        Match[]             @relation("WonMatches")
  wonMatchSets      MatchSet[]

  @@unique([eventId, seedNumber])
  @@map("participants")
}

model ParticipantMember {
  id                  String           @id @default(uuid())
  participantId       String           @map("participant_id")
  userId              String?          @map("user_id")
  playerNameSnapshot  String           @map("player_name_snapshot")
  playerPhoneSnapshot String?          @map("player_phone_snapshot")
  memberOrder         Int              @default(1) @map("member_order")
  invitationStatus    InvitationStatus @default(ACCEPTED) @map("invitation_status")

  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  servingSets   MatchSet[]  @relation("ServingMember")

  @@unique([participantId, memberOrder])
  @@map("participant_members")
}

model Registration {
  id              String             @id @default(uuid())
  participantId   String             @unique @map("participant_id")
  submittedBy     String             @map("submitted_by")
  status          RegistrationStatus @default(PENDING)
  rejectionReason String?            @map("rejection_reason")
  submittedAt     DateTime           @default(now()) @map("submitted_at")
  reviewedBy      String?            @map("reviewed_by")
  reviewedAt      DateTime?          @map("reviewed_at")

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  submitter   User        @relation("RegistrationSubmitter", fields: [submittedBy], references: [id])
  reviewer    User?       @relation("RegistrationReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@map("registrations")
}

model Payment {
  id                   String        @id @default(uuid())
  participantId        String        @map("participant_id")
  amount               Decimal       @db.Decimal(12, 2)
  currency             String        @default("VND")
  paymentMethod        String        @default("BANK_TRANSFER") @map("payment_method")
  transactionReference String?       @map("transaction_reference")
  status               PaymentStatus @default(PENDING)
  paidAt               DateTime?     @map("paid_at")
  createdAt            DateTime      @default(now()) @map("created_at")

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Stage {
  id         String      @id @default(uuid())
  eventId    String      @map("event_id")
  name       String
  stageOrder Int         @default(1) @map("stage_order")
  stageType  StageType   @map("stage_type")
  status     StageStatus @default(PENDING)

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  groups  Group[]
  matches Match[]

  @@map("stages")
}

model Group {
  id         String @id @default(uuid())
  stageId    String @map("stage_id")
  name       String
  groupOrder Int    @default(1) @map("group_order")

  stage        Stage              @relation(fields: [stageId], references: [id], onDelete: Cascade)
  participants GroupParticipant[]
  matches      Match[]

  @@map("groups")
}

model GroupParticipant {
  id            String @id @default(uuid())
  groupId       String @map("group_id")
  participantId String @map("participant_id")

  group       Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([groupId, participantId])
  @@map("group_participants")
}

model Match {
  id                        String         @id @default(uuid())
  eventId                   String         @map("event_id")
  stageId                   String?        @map("stage_id")
  groupId                   String?        @map("group_id")
  courtId                   String?        @map("court_id")
  matchCode                 String         @map("match_code")
  roundName                 String         @map("round_name")
  roundNumber               Int            @default(1) @map("round_number")
  bracketPosition           Int?           @map("bracket_position")
  teamAId                   String?        @map("team_a_id")
  teamBId                   String?        @map("team_b_id")
  scheduledStartTime        DateTime?      @map("scheduled_start_time")
  estimatedDurationMinutes  Int            @default(35) @map("estimated_duration_minutes")
  actualStartTime           DateTime?      @map("actual_start_time")
  actualEndTime             DateTime?      @map("actual_end_time")
  isTimeLocked              Boolean        @default(false) @map("is_time_locked")
  refereeUserId             String?        @map("referee_user_id")
  status                    MatchStatus    @default(SCHEDULED)
  winnerId                  String?        @map("winner_id")
  nextMatchId               String?        @map("next_match_id")
  nextMatchSlot             NextMatchSlot? @map("next_match_slot")
  version                   Int            @default(1)
  createdAt                 DateTime       @default(now()) @map("created_at")
  updatedAt                 DateTime       @updatedAt @map("updated_at")

  event        Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  stage        Stage?            @relation(fields: [stageId], references: [id], onDelete: SetNull)
  group        Group?            @relation(fields: [groupId], references: [id], onDelete: SetNull)
  court        Court?            @relation(fields: [courtId], references: [id], onDelete: SetNull)
  teamA        Participant?      @relation("TeamAMatches", fields: [teamAId], references: [id], onDelete: SetNull)
  teamB        Participant?      @relation("TeamBMatches", fields: [teamBId], references: [id], onDelete: SetNull)
  winner       Participant?      @relation("WonMatches", fields: [winnerId], references: [id], onDelete: SetNull)
  referee      User?             @relation("MatchReferee", fields: [refereeUserId], references: [id], onDelete: SetNull)
  nextMatch    Match?            @relation("BracketProgression", fields: [nextMatchId], references: [id], onDelete: SetNull)
  priorMatches Match[]           @relation("BracketProgression")
  sets         MatchSet[]
  scoreEvents  MatchScoreEvent[]

  @@map("matches")
}

model MatchSet {
  id              String    @id @default(uuid())
  matchId         String    @map("match_id")
  setNumber       Int       @map("set_number")
  scoreTeamA      Int       @default(0) @map("score_team_a")
  scoreTeamB      Int       @default(0) @map("score_team_b")
  servingTeam     String?   @map("serving_team")
  servingPlayerId String?   @map("serving_player_id")
  winningTeamId   String?   @map("winning_team_id")
  completedAt     DateTime? @map("completed_at")

  match         Match              @relation(fields: [matchId], references: [id], onDelete: Cascade)
  winningTeam   Participant?       @relation(fields: [winningTeamId], references: [id], onDelete: SetNull)
  servingMember ParticipantMember? @relation("ServingMember", fields: [servingPlayerId], references: [id], onDelete: SetNull)

  @@unique([matchId, setNumber])
  @@map("match_sets")
}

model MatchScoreEvent {
  id             String         @id @default(uuid())
  matchId        String         @map("match_id")
  setNumber      Int            @map("set_number")
  eventType      ScoreEventType @map("event_type")
  team           String?
  pointsDelta    Int?           @map("points_delta")
  scoreTeamA     Int            @map("score_team_a")
  scoreTeamB     Int            @map("score_team_b")
  servingTeam    String?        @map("serving_team")
  createdBy      String         @map("created_by")
  idempotencyKey String         @unique @map("idempotency_key")
  createdAt      DateTime       @default(now()) @map("created_at")

  match   Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  creator User  @relation(fields: [createdBy], references: [id])

  @@map("match_score_events")
}

model Announcement {
  id           String   @id @default(uuid())
  tournamentId String   @map("tournament_id")
  title        String
  content      String
  publishedAt  DateTime @default(now()) @map("published_at")
  createdBy    String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  author     User       @relation(fields: [createdBy], references: [id])

  @@map("announcements")
}

model Sponsor {
  id           String   @id @default(uuid())
  tournamentId String   @map("tournament_id")
  name         String
  sponsorType  String   @default("GENERAL") @map("sponsor_type")
  tier         Int      @default(1)
  logoUrl      String   @map("logo_url")
  websiteUrl   String?  @map("website_url")
  displayOrder Int      @default(1) @map("display_order")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@map("sponsors")
}

model Notification {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  tournamentId String?  @map("tournament_id")
  title        String
  content      String
  type         String   @default("SYSTEM")
  isRead       Boolean  @default(false) @map("is_read")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id")
  tournamentId String?  @map("tournament_id")
  action       String
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id")
  oldValue     Json?    @map("old_value")
  newValue     Json?    @map("new_value")
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")

  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  tournament Tournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

